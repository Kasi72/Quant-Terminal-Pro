# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unanchored: also covers cloudflare/brain-worker/node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

scripts/_compiled/

# research run artifacts — keep new ones out of the repo root
scripts/results/
scripts/_stop_audit_data.json
scripts/*.log
scripts/*.err.log
*.bak
# Added by code-review-graph
.code-review-graph/

# Local MCP config (contains DB credentials)
.mcp.json
